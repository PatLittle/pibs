{
  "model_version": "1.5",
  "description": "Relational model for authoritative institutions, Info Source holdings, and controlled vocabularies.",
  "tables": {
    "institution_registry": {
      "path": "institution_registry.csv",
      "primary_key": [
        "institution_id"
      ],
      "description": "Schedule I institution authority and publication metadata."
    },
    "institution_classes_of_records": {
      "path": "institutions_infosource_docs/cor_table_en_fr_all.csv",
      "primary_key": [
        "institution_id",
        "record_number"
      ],
      "foreign_keys": [
        {
          "fields": [
            "institution_id"
          ],
          "references": "institution_registry",
          "reference_fields": [
            "institution_id"
          ]
        }
      ]
    },
    "institution_personal_information_banks": {
      "path": "institutions_infosource_docs/pib_table_en_fr_all.csv",
      "primary_key": [
        "institution_id",
        "bank_number_key"
      ],
      "json_array_fields": [
        "specific_information_types_en",
        "specific_information_types_fr",
        "standard_personal_information_category_ids",
        "standard_personal_information_categories_en",
        "standard_personal_information_categories_fr"
      ],
      "description": "Registry-keyed PIBs. Specific information types are conservative source-language derivations from explicit description lists. Standard personal-information categories are conceptual, multi-label derivations from descriptions and those specific types.",
      "foreign_keys": [
        {
          "fields": [
            "institution_id"
          ],
          "references": "institution_registry",
          "reference_fields": [
            "institution_id"
          ]
        },
        {
          "fields": [
            "pib_type"
          ],
          "references": "pib_type_values",
          "reference_fields": [
            "pib_type"
          ]
        }
      ]
    },
    "pib_cor_links": {
      "path": "institutions_infosource_docs/pib_cor_links.csv",
      "primary_key": [
        "institution_id",
        "bank_number_key",
        "language",
        "related_record_number"
      ],
      "description": "Normalized many-to-many links parsed from PIB related-record fields.",
      "foreign_keys": [
        {
          "fields": [
            "institution_id",
            "bank_number_key"
          ],
          "references": "institution_personal_information_banks",
          "reference_fields": [
            "institution_id",
            "bank_number_key"
          ]
        }
      ],
      "polymorphic_target": {
        "discriminator": "relationship_scope",
        "institution_specific": "institution_classes_of_records",
        "standard": "standard_classes_of_records"
      }
    },
    "standard_classes_of_records": {
      "path": "standard_classes_of_records_en_fr.csv",
      "primary_key": [
        "record_number"
      ],
      "alternate_keys": [
        [
          "record_number_en"
        ],
        [
          "record_number_fr"
        ]
      ]
    },
    "standard_personal_information_banks": {
      "path": "spib_en_fr.csv",
      "primary_key": [
        "bank_number_key"
      ],
      "foreign_keys": [
        {
          "fields": [
            "pib_type"
          ],
          "references": "pib_type_values",
          "reference_fields": [
            "pib_type"
          ]
        }
      ]
    },
    "pib_type_values": {
      "path": "pib_type_values.csv",
      "primary_key": [
        "pib_code"
      ],
      "alternate_keys": [
        [
          "pib_type"
        ]
      ],
      "controlled_fields": [
        "institution_personal_information_banks.pib_type",
        "standard_personal_information_banks.pib_type"
      ]
    },
    "personal_information_categories": {
      "path": "pi_categories_en_fr.csv",
      "primary_key": [
        "PI_CAT_ID"
      ],
      "description": "Official controlled vocabulary. My Info assignments are explicitly marked as derived from narrative evidence rather than authoritative source assignments."
    },
    "my_info_pib_features": {
      "path": "data/derived/my_info/my_info_pib_features.csv",
      "primary_key": [
        "record_id"
      ],
      "description": "Compact, source-scoped derived features for the My Info questionnaire. Full matching evidence is retained in the adjacent JSONL artifact."
    },
    "my_info_pib_category_assignments": {
      "path": "data/derived/my_info/my_info_pib_category_assignments.csv",
      "primary_key": [
        "record_id",
        "PI_CAT_ID"
      ],
      "foreign_keys": [
        {
          "fields": [
            "PI_CAT_ID"
          ],
          "references": "personal_information_categories",
          "reference_fields": [
            "PI_CAT_ID"
          ]
        }
      ],
      "description": "Derived, evidence-backed many-to-many assignments from PIB records to the official category vocabulary."
    },
    "service_organizations": {
      "path": "data/service_inventory/organizations.csv",
      "primary_key": [
        "owner_org"
      ],
      "description": "Exact Open Canada organization-slug crosswalk; unresolved or ambiguous institution_id is blank.",
      "foreign_keys": [
        {
          "fields": [
            "institution_id"
          ],
          "references": "institution_registry",
          "reference_fields": [
            "institution_id"
          ]
        }
      ],
      "json_array_fields": [
        "candidates"
      ]
    },
    "service_inventory": {
      "path": "data/service_inventory/service.csv",
      "primary_key": [
        "owner_org",
        "fiscal_yr",
        "service_id"
      ],
      "description": "All 46 published fields. Annual observations; stable graph identity is owner_org + service_id.",
      "foreign_keys": [
        {
          "fields": [
            "owner_org"
          ],
          "references": "service_organizations",
          "reference_fields": [
            "owner_org"
          ]
        }
      ]
    },
    "service_standards": {
      "path": "data/service_inventory/service-std.csv",
      "primary_key": [
        "owner_org",
        "fiscal_yr",
        "service_id",
        "service_standard_id"
      ],
      "description": "All 24 published fields. Annual standards refer to the service in the same organization and fiscal year.",
      "foreign_keys": [
        {
          "fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ],
          "references": "service_inventory",
          "reference_fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ]
        }
      ]
    },
    "service_programs": {
      "path": "data/service_inventory/programs.csv",
      "primary_key": [
        "owner_org",
        "program_id"
      ],
      "description": "Observed program codes scoped to organization. Bilingual labels come from the inspected code list; not historical names or GC InfoBase numeric IDs.",
      "foreign_keys": [
        {
          "fields": [
            "owner_org"
          ],
          "references": "service_organizations",
          "reference_fields": [
            "owner_org"
          ]
        }
      ],
      "json_array_fields": [
        "valid_fiscal_years"
      ]
    },
    "service_program_links": {
      "path": "data/service_inventory/service_program_links.csv",
      "primary_key": [
        "owner_org",
        "fiscal_yr",
        "service_id",
        "program_id"
      ],
      "description": "Literal program codes from actual service observations; no relationships inferred from allowed-value lists.",
      "foreign_keys": [
        {
          "fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ],
          "references": "service_inventory",
          "reference_fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ]
        },
        {
          "fields": [
            "owner_org",
            "program_id"
          ],
          "references": "service_programs",
          "reference_fields": [
            "owner_org",
            "program_id"
          ]
        }
      ]
    },
    "service_program_references": {
      "path": "data/service_inventory/program_references.csv",
      "primary_key": [
        "owner_org",
        "fiscal_yr",
        "service_id",
        "program_id"
      ],
      "description": "Every reported program reference, including invalid markers; unresolved references have no program foreign key.",
      "foreign_keys": [
        {
          "fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ],
          "references": "service_inventory",
          "reference_fields": [
            "owner_org",
            "fiscal_yr",
            "service_id"
          ]
        }
      ]
    }
  },
  "relationships": [
    {
      "name": "institution_has_classes_of_records",
      "cardinality": "one_to_many",
      "from": "institution_registry.institution_id",
      "to": "institution_classes_of_records.institution_id"
    },
    {
      "name": "institution_has_personal_information_banks",
      "cardinality": "one_to_many",
      "from": "institution_registry.institution_id",
      "to": "institution_personal_information_banks.institution_id"
    },
    {
      "name": "pib_relates_to_classes_of_records",
      "cardinality": "many_to_many",
      "through": "pib_cor_links",
      "note": "A related-record value may resolve to an institution-specific class or a Treasury Board standard class."
    },
    {
      "name": "pib_uses_type_vocabulary",
      "cardinality": "many_to_one",
      "from": "institution_personal_information_banks.pib_type",
      "to": "pib_type_values.pib_type"
    },
    {
      "name": "my_info_assigns_personal_information_categories",
      "cardinality": "many_to_many",
      "through": "my_info_pib_category_assignments",
      "note": "Assignments are deterministic estimates with source-field evidence, not authoritative Info Source metadata."
    }
  ],
  "source_provenance": {
    "job_manifest": "data/collection_jobs/institution_collection_jobs_2026-08-15.jsonl",
    "institution_manifest_pattern": "institutions_infosource_docs/<institution_id>/source_manifest.json",
    "raw_snapshot_pattern": "institutions_infosource_docs/<institution_id>/snapshots/<date>/raw/"
  },
  "graph_projection": {
    "path": "site/data/graph.json",
    "schema_version": 3,
    "node_types": [
      "institution",
      "pib",
      "class",
      "pia",
      "reference",
      "service",
      "program",
      "service_standard"
    ],
    "scopes": {
      "pib": [
        "institution",
        "standard"
      ],
      "class": [
        "institution",
        "standard"
      ]
    },
    "relationships": {
      "listed_by": {
        "basis": "documented",
        "meaning": "Record attribution to an institution"
      },
      "references": {
        "basis": "documented",
        "meaning": "Explicit citation; unresolved identifiers remain references, not resolved entities"
      },
      "related_class": {
        "basis": "documented",
        "meaning": "Explicit institution or standard PIB class reference"
      },
      "responsible_official": {
        "basis": "documented",
        "meaning": "AIA names a responsible official; not a current-tenure assertion",
        "runtime": true
      },
      "under_program": {
        "basis": "documented",
        "meaning": "Service reports this exact organization-scoped program code; evidence retains fiscal year"
      },
      "has_standard": {
        "basis": "documented",
        "meaning": "Standard belongs to service using exact owner_org, fiscal_yr and service_id"
      },
      "references_service": {
        "basis": "documented",
        "meaning": "AIA cites exact ServiceID, uniquely resolved within its matched institution; no fiscal year or coverage inferred",
        "runtime": true
      }
    },
    "methodology": "docs/GRAPH_EXPLORER.md",
    "runtime_node_types": [
      "aia",
      "official"
    ],
    "external_source_config": "site/aia-source.json",
    "full_schema": "site/data/network-schema.json",
    "full_diagram": "site/data/network-schema.svg",
    "attribute_vocabularies": {
      "pib_type": "Controlled PIB type value and definition",
      "personal_information_categories": "Derived values with rule, confidence and source evidence; not graph entities"
    },
    "service_inventory_source": "data/service_inventory/manifest.json"
  }
}
